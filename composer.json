{
  "name": "jord-jd/clippy-for-laravel",
  "description": "Clippy for Laravel",
  "type": "library",
  "require": {
    "laravel/framework": "^5.1||^6.0"
  },
  "license": "LGPL-3.0-only",
  "authors": [
    {
      "name": "Jordan Hall",
      "email": "jordan@hall05.co.uk"
    }
  ],
  "autoload": {
    "psr-4": {
      "JordJD\\ClippyForLaravel\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "JordJD\\ClippyForLaravel\\ClippyForLaravelServiceProvider"
      ]
    },
    "branch-alias": {
      "dev-master": "3.0-dev"
    }
  },
  "replace": {
    "divineomega/clippy-for-laravel": "self.version"
  }
}
