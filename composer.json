{
  "name": "jord-jd/clippy-for-laravel",
  "description": "Clippy for Laravel",
  "type": "library",
  "require": {
    "php": ">=7.0",
    "laravel/framework": "^5.1||^6.0||^7.0||^8.0||^9.0||^10.0||^11.0||^12.0||^13.0"
  },
  "license": "LGPL-3.0-only",
  "authors": [
    {
      "name": "Jordan Hall",
      "email": "jordan@hall05.co.uk"
    }
  ],
  "autoload": {
    "psr-4": {
      "JordJD\\ClippyForLaravel\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "JordJD\\ClippyForLaravel\\ClippyForLaravelServiceProvider"
      ]
    },
    "branch-alias": {
      "dev-master": "5.0-dev"
    }
  },
  "replace": {
    "divineomega/clippy-for-laravel": "self.version"
  },
  "autoload-dev": {
    "psr-4": {
      "JordJD\\ClippyForLaravel\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^6.5||^9.6||^12.0"
  }
}
